def alocar_setup_block(linha):
    allowed = get_allowed_hours_for_machine(linha)
    try:
        data, hora = ponteiro[linha]
        for _ in range(6):
            col_index = calcular_indice_coluna_turnos(data, hora)
            producao_hora.iat[linha_mapping[linha], col_index] = "SETUP"
            capacity_used[linha] += 1
            hora += 1
            if hora >= 24:
                break
        if hora >= 24:
            data, hora = avancar_ponteiro_turnos(data, 23, allowed)
        ponteiro[linha] = (data, hora)
        if linha not in setups_info:
            setups_info[linha] = {"6h_count": 0, "6h_time": 0, "2h_count": 0, "2h_time": 0}
        setups_info[linha]["6h_count"] += 1
        setups_info[linha]["6h_time"] += 6
    except ValueError:
        pass

