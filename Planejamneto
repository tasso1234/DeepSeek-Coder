def calcular_saldo_e_realocar(producao_planejada, timeline, production_days, funcionarios_por_dia, shift_max, setups_info):
    """
    Calcula o saldo de produção não realizada para cada SKU e realoca o saldo na timeline.
    """
    for idx, row in producao_planejada.iterrows():
        sku = row["COD SAP"]
        linha_principal = str(row["LINHA"]).strip() if pd.notna(row["LINHA"]) else None
        if linha_principal is None or linha_principal not in timeline:
            continue

        # Calcular produção planejada
        tempo_producao = float(row["Tempo de Produção"])
        prod_hora = float(row["PROD.HORA"]) if not pd.isna(row["PROD.HORA"]) else 0
        producao_planejada_total = tempo_producao * prod_hora

        # Calcular produção efetiva (soma das colunas de datas)
        producao_efetiva_total = 0
        for col in producao_planejada.columns:
            if isinstance(col, str) and col.strip().startswith("20"):  # Verifica se é uma coluna de data
                producao_efetiva_total += float(row[col]) if not pd.isna(row[col]) else 0

        # Calcular saldo
        saldo = producao_planejada_total - producao_efetiva_total
        if saldo <= 0:
            continue  # Não há saldo para realocar

        # Verificar se PROD.HORA é zero
        if prod_hora == 0:
            avisos_list.append(f"SKU {sku} tem 'PROD.HORA' igual a zero; ignorado.")
            continue  # Ignora este SKU e passa para o próximo

        # Converter saldo em horas necessárias
        horas_necessarias = saldo / prod_hora

        # Realocar saldo na timeline
        allocate_fragmented_sku_with_setup(
            linha_principal,
            float(row["QT. FUM"]),
            horas_necessarias,
            sku,
            sku,
            start_slot=0
        )

        # Atualizar funcionários por dia
        for slot in timeline[linha_principal]:
            if slot == sku:
                day_idx = timeline[linha_principal].index(slot) // 24
                hour = timeline[linha_principal].index(slot) % 24
                data_slot = production_days[day_idx]
                data_str = data_slot.strftime("%Y-%m-%d")
                init_funcionarios_for_day(data_slot)
                funcionarios_por_dia[data_str][hour] += float(row["QT. FUM"])

# Chamar a função para calcular saldo e realocar
