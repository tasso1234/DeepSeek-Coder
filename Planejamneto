shift_allowed_hours = {
    1: list(range(6, 14)),
    2: list(range(14, 22)),
    3: list(range(22, 24)) + list(range(0, 6))
}
global_allowed_hours = list(range(24))
allowed_turnos = {}
def get_allowed_hours_for_machine(machine_line):
    if machine_line in allowed_turnos:
        allowed = []
        for s in allowed_turnos[machine_line]:
            allowed.extend(shift_allowed_hours.get(s, []))
        return sorted(list(set(allowed)))
    else:
        return global_allowed_hours

def get_shift(hour):
    if 6 <= hour < 14:
        return 1
    elif 14 <= hour < 22:
        return 2
    else:
        return 3

def avancar_ponteiro_turnos(data, current_hour, allowed_hours):
    next_hours = [h for h in allowed_hours if h > current_hour]
    if next_hours:
        return data, next_hours[0]
    else:
        idx = production_days.index(data)
        for j in range(idx+1, len(production_days)):
            if is_dia_util(production_days[j]):
                return production_days[j], allowed_hours[0]
        raise ValueError("Fim dos dias úteis.")

def calcular_indice_coluna_turnos(data, hour):
    idx = production_days.index(data)
    return idx * 24 + (hour + 1)

def get_capacity_factor(hour):
    if hour in [0, 1, 2, 9, 10, 11, 17, 18, 19]:
        return 0.7
    else:
        return 1.0

