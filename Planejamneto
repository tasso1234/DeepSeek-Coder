# ===========================================================
# Função de Alocação Fragmentada com Setup Obrigatório na Troca de SKU
# (Utilizada para qualquer linha; agora aceita start_slot e evita >2 setups simultâneos)
# ===========================================================
def allocate_fragmented_sku_with_setup(linha, req_mod, required_hours, sku, new_group, start_slot=0):
    """
    Aloca os slots da timeline para o SKU, iniciando a busca a partir de start_slot.
    Garante que, se houver mudança de SKU, seja inserido um bloco CONTÍNUO de 6 horas de setup
    antes do início da produção do novo SKU. Além disso, verifica se cada slot do bloco a ser inserido
    possui menos de 2 setups já alocados.
    Retorna (lista de índices alocados, número total de horas alocadas).
    """
    tline = timeline[linha]
    allocated_slots = []
    if linha not in ultimo_sku:
        ultimo_sku[linha] = None
    for slot in range(start_slot, len(tline)):
        day_idx = slot // 24
        if day_idx >= len(production_days):
            continue
        hour = slot % 24
        data_slot = production_days[day_idx]
        data_str = data_slot.strftime("%Y-%m-%d")
        init_funcionarios_for_day(data_slot)
        
        if tline[slot] != "":
            continue
        
        allocated = funcionarios_por_dia[data_str][hour]
        factor = get_capacity_factor(hour)
        turno = get_shift(hour)
        capacity = shift_max[turno] * factor
        if capacity - allocated < req_mod:
            continue
        
        # Se for o primeiro slot para este SKU num novo lote
        if not allocated_slots:
            # Verifica necessidade de setup se houve alteração de SKU
            if ultimo_slot.get(linha) is not None and ultimo_sku[linha] != sku:
                start_block = slot - 6
                day_start = (slot // 24) * 24
                if start_block < day_start:
                    continue
                can_setup = True
                # Verifica se os 6 slots anteriores estão livres e com setup count < 2
                for s in range(start_block, slot):
                    if tline[s] != "" or setup_global_counter.get(s, 0) >= 2:
                        can_setup = False
                        break
                if not can_setup:
                    continue
                # Insere o bloco de setup e atualiza o contador global para cada slot
                for s in range(start_block, slot):
                    tline[s] = "SETUP"
                    setup_global_counter[s] = setup_global_counter.get(s, 0) + 1
                if linha not in setups_info:
                    setups_info[linha] = {"6h_count": 0, "6h_time": 0, "2h_count": 0, "2h_time": 0}
                setups_info[linha]["6h_count"] += 1
                setups_info[linha]["6h_time"] += 6
            tline[slot] = sku
            allocated_slots.append(slot)
            ultimo_slot[linha] = slot
            ultimo_sku[linha] = new_group
        else:
            # Se o slot continua a produção contígua no mesmo dia, aloca-o
            if ultimo_slot[linha] is not None and slot == ultimo_slot[linha] + 1 and (slot // 24 == ultimo_slot[linha] // 24):
                tline[slot] = sku
                allocated_slots.append(slot)
                ultimo_slot[linha] = slot
            else:
                tline[slot] = sku
                allocated_slots.append(slot)
                ultimo_slot[linha] = slot
        if len(allocated_slots) >= required_hours:
            break
    return allocated_slots, len(allocated_slots)

