    if sku not in sku_aggregates:
        sku_aggregates[sku] = {
            "lines": set(),
            "prod_by_line": {},
            "planned_qty": 0,
            "planned_primary": None,
            "total_produced": 0
        }
    sku_aggregates[sku]["lines"].add(linha)
    sku_aggregates[sku]["prod_by_line"][linha] = data["quantidade"]
    sku_aggregates[sku]["total_produced"] += data["quantidade"]

for idx, row in producao_planejada.iterrows():
    sku_val = str(row["COD SAP"]).upper()
    if sku_val in sku_aggregates and sku_aggregates[sku_val]["planned_primary"] is None:
        sku_aggregates[sku_val]["planned_primary"] = str(row["LINHA"]).strip()
        sku_aggregates[sku_val]["planned_qty"] = float(row["PROD.HORA"]) * int(float(row["Tempo de Produção"]))

secundaria_rows = []
for sku, info in sku_aggregates.items():
    planned_primary = info["planned_primary"] if info["planned_primary"] is not None else ""
    produzido_na_primaria = info["prod_by_line"].get(planned_primary, 0)
    produzido_nas_outras = info["total_produced"] - produzido_na_primaria
    if produzido_nas_outras > 0:
        linhas_producao = ", ".join(sorted(list(info["lines"])))
        secundaria_rows.append({
            "SKU": sku,
            "Linha Primária": planned_primary,
            "Quantidade Programada": info["planned_qty"],
            "Produzido na Linha Primária": produzido_na_primaria,
            "Produzido nas Outras Linhas": produzido_nas_outras,
            "Linha(s) Produção": linhas_producao
        })
secundaria_df = pd.DataFrame(secundaria_rows)

# ===========================================================
# 14. Aba de SKUs Não Produzidos
# ===========================================================
nao_produzidos_rows = []
producao_por_sku = {}
for (linha, sku), data in production_summary.items():
    key = sku.upper()
    producao_por_sku[key] = producao_por_sku.get(key, 0) + data["quantidade"]

for idx, row in producao_planejada.iterrows():
    sku_val = str(row["COD SAP"]).upper()
    horas_requeridas = row["Tempo de Produção"]
    prod_hora_planned = float(row["PROD.HORA"]) if not pd.isna(row["PROD.HORA"]) else 0
    quant_programada = prod_hora_planned * float(horas_requeridas)
    if sku_val not in producao_por_sku or producao_por_sku[sku_val] == 0:
        nao_produzidos_rows.append({
            "SKU": sku_val,
            "Linha Planejada": str(row["LINHA"]).strip() if pd.notna(row["LINHA"]) else "",
            "Horas Requeridas": horas_requeridas,
            "Quantidade Programada": quant_programada,
            "Produzido": 0,
            "Erro": "Produção não realizada"
        })
nao_produzidos_df = pd.DataFrame(nao_produzidos_rows)

# ===========================================================
# 15. Aba de Resumo Diário
# ===========================================================
daily_production = {}
for i, row in producao_hora_final.iterrows():
    production_line = row.iloc[0]
    for j in range(1, len(row)):
        cell_value = row.iloc[j]
        if cell_value and str(cell_value).strip() != "SETUP":
            sku = str(cell_value).strip()
            day_index = (j - 1) // 24
            if day_index < len(production_days):
                data_str = production_days[day_index].strftime("%Y-%m-%d")
            else:
                continue
            prod_value = prod_hora_dict.get(sku, 0)
            key = (production_line, sku, data_str)
            daily_production[key] = daily_production.get(key, 0) + prod_value
df_daily = pd.DataFrame([
    {"Linha": linha, "SKU": sku, "Data": data, "Produção": prod}
    for (linha, sku, data), prod in daily_production.items()
])
resumo_diario = df_daily.pivot_table(
    index=["Linha", "SKU"],
    columns="Data",
    values="Produção",
    aggfunc="sum",
    fill_value=0
)

# ===========================================================
# 19. Atualização da Aba "Resumo Diário" com Saldo
# ===========================================================
def atualizar_resumo_diario_com_saldo(resumo_diario, producao_planejada, timeline, production_days):
    """
    Atualiza a aba "Resumo Diário" com informações sobre o saldo de produção.
    """
    for idx, row in producao_planejada.iterrows():
        sku = row["COD SAP"]
        linha_principal = str(row["LINHA"]).strip() if pd.notna(row["LINHA"]) else None
        if linha_principal is None or linha_principal not in timeline:
            continue

        # Calcular produção planejada e efetiva
        tempo_producao = float(row["Tempo de Produção"])
        prod_hora = float(row["PROD.HORA"]) if not pd.isna(row["PROD.HORA"]) else 0
        producao_planejada_total = tempo_producao * prod_hora
        producao_efetiva_total = 0
        for col in producao_planejada.columns:
            if isinstance(col, str) and col.strip().startswith("20"):
                producao_efetiva_total += float(row[col]) if not pd.isna(row[col]) else 0

        # Calcular saldo
        saldo = producao_planejada_total - producao_efetiva_total

        # Adicionar saldo ao resumo diário
        if sku in resumo_diario.index:
            resumo_diario.at[sku, "Saldo"] = saldo
        else:
            resumo_diario.loc[sku] = {"Saldo": saldo}

# Chamar a função para atualizar o resumo diário
atualizar_resumo_diario_com_saldo(resumo_diario, producao_planejada, timeline, production_days)

