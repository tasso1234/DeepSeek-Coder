# NOVA Função: Alocação Multilinha para um SKU
# ===========================================================
def allocate_multiline_sku(row):
    """
    Tenta alocar a produção do SKU inicialmente na linha principal (coluna "LINHA").
    Se a linha principal não tiver capacidade completa, tenta alocar o restante
    nas linhas alternativas (ex: "LINHA 2" e "LINHA 3").
    
    Se a linha especificada não existir na timeline, emite um aviso e ignora a alocação.
    Adicionalmente, se na planilha "Produção Planejada" existir um valor na coluna "Prioridade",
    esse valor (entre 1 e 31) indica o dia do mês em que o SKU deverá começar a ser produzido.
    """
    sku = row["COD SAP"]
    if pd.isna(row["Tempo de Produção"]):
        avisos_list.append(f"SKU {sku} com 'Tempo de Produção' ausente; ignorado.")
        return
    required_hours = int(float(row["Tempo de Produção"]))
    req_mod = float(row["QT. FUM"])
    prod_value = float(row["PROD.HORA"]) if not pd.isna(row["PROD.HORA"]) else 0
    if prod_value * required_hours == 0:
        avisos_list.append(f"SKU {sku} com volume zero; ignorado.")
        return

    new_sku = str(sku).upper()

    primary_line = str(row["LINHA"]).strip() if pd.notna(row["LINHA"]) else None
    if primary_line is None:
        avisos_list.append(f"SKU {sku} sem linha principal definida; ignorado.")
        return
    if primary_line not in timeline:
        avisos_list.append(f"SKU {sku}: linha principal '{primary_line}' não encontrada na timeline; ignorado.")
        return

    # Verifica se há valor na coluna Prioridade (dia do mês)
    start_slot_index = 0
    if "Prioridade" in row and not pd.isna(row["Prioridade"]):
        try:
            desired_day = int(row["Prioridade"])
            found_date = None
            for day in production_days:
                if day.day == desired_day:
                    found_date = day
                    break
            if found_date is not None:
                start_slot_index = production_days.index(found_date) * 24
        except Exception as e:
            pass

    alternative_lines = []
    if "LINHA 2" in row and pd.notna(row["LINHA 2"]):
        alternative_lines.append(str(row["LINHA 2"]).strip())
    if "LINHA 3" in row and pd.notna(row["LINHA 3"]):
        alternative_lines.append(str(row["LINHA 3"]).strip())

    allocated_total = 0
    indices, allocated = allocate_fragmented_sku_with_setup(primary_line, req_mod, required_hours, sku, new_sku, start_slot_index)
    allocated_total += allocated
    production_summary.setdefault((primary_line, sku), {"horas": 0, "quantidade": 0})
    production_summary[(primary_line, sku)]["horas"] += allocated
    production_summary[(primary_line, sku)]["quantidade"] += prod_value * allocated
    for slot in indices:
        day_idx = slot // 24
        hour = slot % 24
        data_slot = production_days[day_idx]
        data_str = data_slot.strftime("%Y-%m-%d")
        init_funcionarios_for_day(data_slot)
        funcionarios_por_dia[data_str][hour] += req_mod

    if allocated_total < required_hours:
        restante = required_hours - allocated_total
        for alt_line in alternative_lines:
            if alt_line not in timeline:
                avisos_list.append(f"SKU {sku}: linha alternativa '{alt_line}' não encontrada na timeline; ignorada.")
                continue
            indices_alt, allocated_alt = allocate_fragmented_sku_with_setup(alt_line, req_mod, restante, sku, new_sku, 0)
            if allocated_alt > 0:
                production_summary.setdefault((alt_line, sku), {"horas": 0, "quantidade": 0})
                production_summary[(alt_line, sku)]["horas"] += allocated_alt
                production_summary[(alt_line, sku)]["quantidade"] += prod_value * allocated_alt
                for slot in indices_alt:
                    day_idx = slot // 24
                    hour = slot % 24
                    data_slot = production_days[day_idx]
                    data_str = data_slot.strftime("%Y-%m-%d")
                    init_funcionarios_for_day(data_slot)
                    funcionarios_por_dia[data_str][hour] += req_mod
                allocated_total += allocated_alt
                restante = required_hours - allocated_total
            if restante <= 0:
                break
    if allocated_total < required_hours:
        avisos_list.append(f"SKU {sku} não alocado completamente. Horas requeridas: {required_hours}, alocadas: {allocated_total}")

